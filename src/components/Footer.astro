<footer class="mt-20 border-t border-textSecondary/20 bg-card/95 backdrop-blur-xl relative z-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 sm:gap-12 pb-12 border-b border-textSecondary/15">
      
      {/* Brand Info Column */}
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="inline-flex items-center group">
          <div class="bg-accent text-onAccent px-3 py-1 rounded-xl shadow-md border border-accent2/60 flex items-center gap-0.5 group-hover:scale-105 transition-transform">
            <span class="font-handwritten text-2xl font-bold lowercase tracking-normal text-onAccent leading-none">padh</span>
            <span class="font-extrabold text-base tracking-wider uppercase font-sans text-onAccent leading-none">DSA</span>
          </div>
        </a>
        <p class="text-xs sm:text-sm text-textSecondary leading-relaxed font-medium">
          Master Data Structures & Algorithms visually. Interactive animations, real-life analogies, and hands-on playgrounds for computer science students.
        </p>
      </div>

      {/* Learning Modules Column */}
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-extrabold text-accent uppercase tracking-wider">
          Learning Modules
        </h4>
        <ul class="space-y-2.5 text-sm font-semibold text-textSecondary">
          <li><a href="/onboarding" class="hover:text-accent transition-colors">Start Roadmap</a></li>
          <li><a href="/learn" class="hover:text-accent transition-colors font-medium">Unified Learning Guide</a></li>
          <li><a href="/playground" class="hover:text-accent transition-colors font-medium">Algorithm Playground</a></li>
          <li><a href="/quiz" class="hover:text-accent transition-colors font-medium">Master Quiz</a></li>
        </ul>
      </div>

      {/* Legal & MPA Pages Column (Footer Exclusive) */}
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-extrabold text-accent uppercase tracking-wider">
          Company & Legal
        </h4>
        <ul class="space-y-2.5 text-sm font-semibold text-textSecondary">
          <li><a href="/about" class="hover:text-accent transition-colors">About Us</a></li>
          <li><a href="/privacy-policy" class="hover:text-accent transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-accent transition-colors">Terms & Conditions</a></li>
          <li><a href="/contact" class="hover:text-accent transition-colors">Contact Us</a></li>
        </ul>
      </div>

      {/* Support & Contact Details Column */}
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-extrabold text-accent uppercase tracking-wider">
          Support & Help
        </h4>
        <p class="text-xs sm:text-sm text-textSecondary leading-relaxed font-medium">
          Have questions or feedback? Our team is dedicated to making CS education accessible.
        </p>
        <div class="pt-1">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-focusBg border border-focusBorder text-focusText text-xs font-mono font-extrabold px-4 py-2 rounded-xl hover:scale-105 transition-transform"
          >
            <span>💬 Send Us a Message</span>
          </a>
        </div>
      </div>

    </div>

    {/* Copyright & Disclaimer Notice */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-textSecondary font-medium">
      <p>© 2026 padhDSA Platform. All rights reserved.</p>
      <p>Built with ❤️ for CS Beginners worldwide.</p>
    </div>
  </div>
</footer>
