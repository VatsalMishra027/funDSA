---
import '../styles/global.css';
import Interactive3DFigures from '../components/Interactive3DFigures';
import LanguageSwitcher from '../components/LanguageSwitcher';
import Footer from '../components/Footer.astro';
import { FAQ_DATA } from '../components/FaqSection';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'padhDSA | Best Resources & Best Way to Learn DSA for Beginners 2026',
  description = 'Master Data Structures & Algorithms with padhDSA! The best resource to learn DSA for beginners with interactive step-by-step visualizers, real-world analogies in Java, Python & C++, and hands-on playgrounds.',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://padhdsa.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteUrl);
const fullImageUrl = new URL(image, Astro.site || siteUrl).href;

const keywords = [
  'dsa for beginners',
  'best resources to learn dsa for beginners',
  'best way to learn dsa for beginners',
  'how to start dsa for beginners',
  'how to start learning dsa for beginners',
  'how to get better at dsa for beginners',
  'java dsa for beginners',
  'dsa for beginners in python',
  'how to learn dsa for beginners',
  'best resources to learn dsa for beginners 2026',
  'best youtube channel to learn dsa for beginners',
  'data structures and algorithms visualizer',
  'bubble sort visualizer',
].join(', ');

const appJsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'padhDSA',
  'applicationCategory': 'EducationalApplication',
  'operatingSystem': 'Any',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD',
  },
  'description': description,
  'url': canonicalURL.href,
  'author': {
    '@type': 'Organization',
    'name': 'padhDSA Team',
  },
};

const faqJsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': FAQ_DATA.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': `<p>${item.answer}</p>`,
    },
  })),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FEKFD8F6WY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FEKFD8F6WY');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Exclusive PNG Favicon -->
    <link rel="icon" type="image/png" href="/favicon2.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon2.png" />
    <link rel="apple-touch-icon" href="/favicon2.png" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="padhDSA" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="padhDSA Platform" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- JSON-LD Structured Data for App & Google Rich FAQ Snippets -->
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLdSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLdSchema)} />
    
    <!-- Script to prevent dark mode FOUC -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('theme');
        if (
          storedTheme === 'dark' ||
          (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-bg text-main min-h-screen flex flex-col selection:bg-accent2 selection:text-focusText relative overflow-x-hidden">
    <!-- Interactive 3D Figures WebGL Background -->
    <Interactive3DFigures client:load />

    <!-- Navigation Header -->
    <header class="border-b border-textSecondary/20 bg-card/85 backdrop-blur-md sticky top-0 z-40 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
        
        <!-- Big & Bold padhDSA Platform Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="bg-accent text-onAccent px-4 py-1.5 rounded-xl shadow-md border border-accent2/60 group-hover:scale-105 group-hover:bg-accent/90 transition-all duration-300 flex items-center gap-0.5">
            <span class="font-handwritten text-3xl font-bold lowercase tracking-normal text-onAccent leading-none">padh</span>
            <span class="font-extrabold text-xl tracking-wider uppercase font-sans text-onAccent leading-none">DSA</span>
          </div>
          <div class="flex flex-col">
            <span class="font-black text-xl sm:text-2xl tracking-tight text-main group-hover:text-accent transition-colors leading-tight">
              Visual Platform
            </span>
            <span class="text-[11px] font-mono font-bold text-textSecondary tracking-wide">
              Data Structures & Algorithms
            </span>
          </div>
        </a>

        <!-- Header Nav Links & Dynamic Onboarding Protection State -->
        <div class="flex items-center gap-3 sm:gap-5">
          <!-- Motivating Professional & Official Gen-Z Badge (Shown on First & Second Pages) -->
          <div
            id="nav-genz-badge"
            class="inline-flex items-center gap-2 bg-focusBg border border-focusBorder text-focusText text-xs font-mono font-black px-3.5 py-1.5 rounded-xl tracking-wide shadow-xs"
          >
            <span>⚡ ZERO RATTA • HIGH-KEY INTUITION • LOCK IN YOUR VIBE 🚀</span>
          </div>

          <!-- Module Navigation Links (Hidden until Onboarding is completed) -->
          <div id="nav-protected-links" class="hidden items-center gap-4 sm:gap-6">
            <a
              href="/learn"
              class="text-sm font-extrabold text-textSecondary hover:text-accent hover:-translate-y-0.5 transition-all duration-200"
            >
              Learn Guide
            </a>
            <a
              href="/playground"
              class="text-sm font-extrabold text-textSecondary hover:text-accent hover:-translate-y-0.5 transition-all duration-200"
            >
              Playground
            </a>
            <a
              href="/quiz"
              class="text-sm font-extrabold text-textSecondary hover:text-accent hover:-translate-y-0.5 transition-all duration-200"
            >
              Master Quiz
            </a>
          </div>

          <!-- Optional Start Button (Controlled via JS) -->
          <a
            id="nav-start-btn"
            href="/onboarding"
            class="hidden group relative inline-flex items-center justify-center gap-2 bg-gradient-to-r from-accent via-[#E05338] to-accent2 text-onAccent px-4 py-2 rounded-xl font-black text-xs sm:text-sm shadow-md shadow-accent/20 border border-accent2/40 ring-1 ring-white/20 hover:scale-105 hover:shadow-lg transition-all duration-300 overflow-hidden"
          >
            {/* Light Shimmer Effect */}
            <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></span>

            <span class="tracking-wide text-white drop-shadow-[0_1px_2px_rgba(0,0,0,0.3)]">Start</span>

            {/* Hyper-Crisp Vector Rocket Icon */}
            <span class="p-1 rounded-lg bg-white/20 border border-white/30 text-white shadow-xs group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
                <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-3.05 11a22.35 22.35 0 0 1-3.95 2z"/>
                <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
              </svg>
            </span>
          </a>

          <!-- Premium Theme Toggle Button -->
          <button
            id="theme-toggle"
            type="button"
            class="px-3.5 py-2 rounded-xl border border-textSecondary/25 bg-card/80 backdrop-blur-md text-main hover:border-accent hover:shadow-lg active:scale-95 transition-all duration-300 flex items-center gap-2.5 text-xs sm:text-sm font-extrabold shadow-sm"
            aria-label="Toggle Theme"
          >
            <span class="dark:hidden flex items-center gap-2">
              <span class="p-1 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
              </span>
              <span class="hidden md:inline font-bold tracking-wide">Dark</span>
            </span>
            <span class="hidden dark:flex items-center gap-2">
              <span class="p-1 rounded-lg bg-amber-500/15 text-amber-400 flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
              </span>
              <span class="hidden md:inline font-bold tracking-wide">Light</span>
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />


    <!-- Theme Toggle & Navigation Protection Script -->
    <script is:inline>
      // Theme Toggle Logic
      const toggleBtn = document.getElementById('theme-toggle');
      toggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Navigation Visibility & Protection Guard
      (function () {
        try {
          const currentPath = window.location.pathname;
          const is404 = document.getElementById('is-404-page') !== null || document.title.includes('404') || currentPath.includes('/404');
          const isPreOnboardingPage =
            is404 ||
            currentPath === '/' ||
            currentPath === '/index.html' ||
            currentPath === '' ||
            currentPath.includes('/onboarding') ||
            currentPath.includes('/about') ||
            currentPath.includes('/privacy-policy') ||
            currentPath.includes('/terms') ||
            currentPath.includes('/contact') ||
            currentPath.includes('/500');

          const links = document.getElementById('nav-protected-links');
          const badge = document.getElementById('nav-genz-badge');
          const startBtn = document.getElementById('nav-start-btn');

          // If on First Page (Home) or Second Page (Onboarding), REMOVE all 4 nav links & show motivating Gen-Z badge
          if (isPreOnboardingPage) {
            if (links) {
              links.classList.add('hidden');
              links.classList.remove('flex');
            }
            if (startBtn) {
              startBtn.classList.add('hidden');
              startBtn.classList.remove('flex');
            }
            if (badge) {
              badge.classList.remove('hidden');
            }
            return;
          }

          // On inner module pages (/learn, /playground, /quiz), check if onboarded
          const rawProfile = localStorage.getItem('bubble_sort_student_profile_v1');
          let isOnboarded = false;
          if (rawProfile) {
            const parsed = JSON.parse(rawProfile);
            if (parsed && parsed.name && parsed.name.trim() !== '') {
              isOnboarded = true;
            }
          }

          if (isOnboarded) {
            // User is onboarded: Show module navigation links!
            if (links) {
              links.classList.remove('hidden');
              links.classList.add('flex');
            }
            if (startBtn) {
              startBtn.classList.add('hidden');
              startBtn.classList.remove('flex');
            }
            if (badge) {
              badge.classList.add('hidden');
            }
          } else {
            // Un-onboarded user trying to access inner pages -> Redirect to /onboarding
            window.location.href = '/onboarding';
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
