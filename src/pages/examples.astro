---
import Layout from '../layouts/Layout.astro';
import BubbleSortVisualizer from '../components/BubbleSortVisualizer';

const examplesList = [
  {
    id: 'cricket',
    title: '🏏 Example 1: Indian Cricket ODI Highest Scores',
    interest: 'Cricket',
    description: 'Rohit, Kohli, Dhoni, Gill, aur Pant ke scores ko lowest-to-highest sort karte hain.',
    items: [
      { label: 'Gill', value: 91, icon: '⭐' },
      { label: 'Pant', value: 125, icon: '🔥' },
      { label: 'Dhoni', value: 148, icon: '🧤' },
      { label: 'Kohli', value: 183, icon: '🏏' },
      { label: 'Rohit', value: 264, icon: '💥' },
    ],
  },
  {
    id: 'canteen',
    title: '🥟 Example 2: School Canteen Price List (in ₹)',
    interest: 'Food',
    description: 'Chai (₹10) se lekar Pizza (₹250) tak canteen menu prices ko budget order mein lagana.',
    items: [
      { label: 'Chai', value: 10, icon: '☕' },
      { label: 'Samosa', value: 15, icon: '🥟' },
      { label: 'Maggi', value: 45, icon: '🍜' },
      { label: 'Roll', value: 80, icon: '🌯' },
      { label: 'Pizza', value: 250, icon: '🍕' },
    ],
  },
  {
    id: 'gaming',
    title: '🎮 Example 3: PUBG Match Squad Kills',
    interest: 'Gaming',
    description: 'Match ke baad alag-alag squads ke total kills ko leaderboard order mein arrange karna.',
    items: [
      { label: 'Squad Delta', value: 4, icon: '🛡️' },
      { label: 'Squad Beta', value: 11, icon: '🔭' },
      { label: 'Squad Alpha', value: 14, icon: '🎯' },
      { label: 'Squad Omega', value: 22, icon: '⚡' },
    ],
  },
  {
    id: 'movies',
    title: '🎬 Example 4: Bollywood Movie Ratings (%)',
    interest: 'Bollywood/Movies',
    description: 'Audience ratings ke hisab se movies ko sort karke blockbuster order mein set karna.',
    items: [
      { label: 'Flop Show', value: 30, icon: '🍅' },
      { label: 'Average Pic', value: 65, icon: '🎟️' },
      { label: 'Hit Film', value: 82, icon: '🍿' },
      { label: 'Blockbuster', value: 96, icon: '🏆' },
    ],
  },
];
---

<Layout title="Worked Examples Gallery | Bubble Sort">
  <div class="max-w-4xl mx-auto space-y-10 py-4 sm:py-8">
    {/* Page Header */}
    <div class="text-center space-y-3">
      <span class="bg-focusBg border border-focusBorder text-focusText text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">
        Real-Life Gallery 🖼️
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
        Worked <span class="text-accent font-handwritten text-4xl sm:text-6xl">Examples</span>
      </h1>
      <p class="text-textSecondary text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Dekho kaise alag-alag hobbies (Cricket, Food, Gaming, Movies) ke real data par 
        Bubble Sort kaam karta hai.
      </p>
    </div>

    {/* Examples Showcase Cards */}
    <div class="space-y-12">
      {examplesList.map((ex) => (
        <div class="bg-card border border-textSecondary/20 rounded-3xl p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-textSecondary/15 pb-4">
            <div>
              <h2 class="text-xl font-extrabold text-main">{ex.title}</h2>
              <p class="text-xs text-textSecondary mt-1">{ex.description}</p>
            </div>
            <span class="bg-focusBg border border-focusBorder text-focusText text-xs font-bold px-3 py-1 rounded-lg">
              {ex.interest}
            </span>
          </div>

          <BubbleSortVisualizer
            client:visible
            items={ex.items}
            title={`${ex.interest} Sorting Example`}
          />
        </div>
      ))}
    </div>

    {/* Bottom CTA */}
    <div class="pt-6 text-center flex justify-center gap-4">
      <a
        href="/playground"
        class="px-5 py-2.5 rounded-xl border border-textSecondary/30 bg-bg text-main hover:border-accent text-sm font-semibold"
      >
        🧪 Try Playground
      </a>
      <a
        href="/quiz"
        class="btn-primary px-6 py-2.5 rounded-xl text-sm font-bold shadow-sm"
      >
        Take Recap Quiz →
      </a>
    </div>
  </div>
</Layout>
