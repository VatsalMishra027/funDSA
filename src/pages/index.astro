---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bubble Sort | DSA Seekho Apne Style Mein">
  <section class="max-w-3xl mx-auto text-center py-12 space-y-6">
    <div class="inline-block bg-focusBg border border-focusBorder text-focusText text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
      ⚡ Class 11th & 12th Special • Zero Prior Coding Required
    </div>
    
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
      Bubble Sort Seekho <br />
      <span class="text-accent font-handwritten text-5xl sm:text-6xl">Bina Kisi Exam Stress Ke!</span>
    </h1>

    <p class="text-textSecondary text-lg max-w-xl mx-auto leading-relaxed">
      Suno, DSA se darna band karo. Yahan koi boring textbook definitions nahi hain — sirf 
      apne favourite hobbies aur daily line-mein-khade-hone waale examples ke sath 
      step-by-step seekhenge!
    </p>

    <div class="pt-4 flex justify-center gap-4">
      <a href="/onboarding" class="btn-primary px-8 py-3.5 rounded-xl font-bold text-base shadow-chalk flex items-center gap-2">
        Aao Shuru Karein 🚀
      </a>
    </div>
  </section>
</Layout>
