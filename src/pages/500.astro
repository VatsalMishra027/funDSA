---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="500: Unexpected Runtime Error | padhDSA Visual Algorithm Learning Platform"
  description="Oops! An unexpected internal runtime error occurred. Reload the page or return to padhDSA home page."
>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center py-12 px-4 space-y-8 relative z-10">
    
    {/* Animated 500 Pill Badge */}
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 bg-focusBg border border-focusBorder text-focusText text-xs font-mono font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-xs">
        <span>ERROR CODE 500</span>
      </div>

      <h1 class="text-7xl sm:text-9xl font-black tracking-tighter text-main drop-shadow-sm">
        5<span class="bg-gradient-to-r from-accent via-[#FF7A57] to-accent2 bg-clip-text text-transparent font-handwritten text-8xl sm:text-[10rem]">0</span>0
      </h1>

      <h2 class="text-2xl sm:text-4xl font-black text-main tracking-tight">
        Unexpected Execution Stack Swap ⚡
      </h2>

      <p class="text-textSecondary text-base sm:text-lg max-w-md mx-auto font-medium leading-relaxed">
        An unexpected internal runtime condition occurred while processing page assets. Try reloading or return home.
      </p>
    </div>

    {/* Quick Action Navigation Buttons */}
    <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
      <button
        onclick="window.location.reload();"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent text-onAccent font-black px-7 py-3.5 rounded-2xl text-base shadow-lg hover:scale-105 transition-transform cursor-pointer"
      >
        <span>🔄 Reload Page</span>
      </button>

      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-card border border-textSecondary/30 hover:border-accent text-main font-extrabold px-7 py-3.5 rounded-2xl text-base shadow-sm hover:scale-105 transition-all"
      >
        <span>🏠 Return Home</span>
      </a>
    </div>

    {/* Secondary Contact Link */}
    <div class="pt-4 text-xs font-mono text-textSecondary font-medium">
      Need assistance? <a href="/contact" class="text-accent underline font-bold">Contact Student Support 💬</a>
    </div>

  </div>
</Layout>
