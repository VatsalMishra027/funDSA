---
import Layout from '../layouts/Layout.astro';
import PlaygroundBuilder from '../components/PlaygroundBuilder';
---

<Layout title="Sorting Playground | Build Your Own List">
  <div class="max-w-4xl mx-auto space-y-8 py-4 sm:py-8">
    {/* Page Header */}
    <div class="text-center space-y-3">
      <span class="bg-focusBg border border-focusBorder text-focusText text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">
        Interactive Lab 🧪
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
        Bubble Sort <span class="text-accent font-handwritten text-4xl sm:text-6xl">Playground</span>
      </h1>
      <p class="text-textSecondary text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Apne favourite items ki custom list banao (4-6 items) ya presets load karo. 
        Then watch them step-by-step bubble up to the right order!
      </p>
    </div>

    {/* Playground Builder Island */}
    <PlaygroundBuilder client:load />

    {/* Quick Navigation Footer */}
    <div class="pt-6 text-center flex flex-wrap justify-center gap-4 border-t border-textSecondary/20">
      <a
        href="/examples"
        class="px-5 py-2.5 rounded-xl border border-textSecondary/30 bg-bg text-main hover:border-accent text-sm font-semibold"
      >
        📖 View Worked Examples
      </a>
      <a
        href="/quiz"
        class="btn-primary px-6 py-2.5 rounded-xl text-sm font-bold shadow-sm"
      >
        Take Funny Quiz →
      </a>
    </div>
  </div>
</Layout>
