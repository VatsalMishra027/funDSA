---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404: Page Not Found | padhDSA Visual Algorithm Learning Platform"
  description="Oops! The page you are looking for does not exist or has been moved. Return to padhDSA home page to continue learning."
>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center py-12 px-4 space-y-8 relative z-10">
    
    {/* Animated 404 Pill Badge */}
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 bg-focusBg border border-focusBorder text-focusText text-xs font-mono font-extrabold px-4 py-1.5 rounded-full uppercase tracking-wider shadow-xs">
        <span>ERROR CODE 404</span>
      </div>

      <h1 class="text-7xl sm:text-9xl font-black tracking-tighter text-main drop-shadow-sm">
        4<span class="bg-gradient-to-r from-accent via-[#FF7A57] to-accent2 bg-clip-text text-transparent font-handwritten text-8xl sm:text-[10rem]">0</span>4
      </h1>

      <h2 class="text-2xl sm:text-4xl font-black text-main tracking-tight">
        Page Sorted Out of Existence 🔍
      </h2>

      <p class="text-textSecondary text-base sm:text-lg max-w-md mx-auto font-medium leading-relaxed">
        The route you tried to access doesn't exist, was moved, or got swapped during an algorithm pass!
      </p>
    </div>

    {/* Quick Action Navigation Buttons */}
    <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
      <a
        href="/"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent text-onAccent font-black px-7 py-3.5 rounded-2xl text-base shadow-lg hover:scale-105 transition-transform"
      >
        <span>🏠 Return Home</span>
      </a>

      <a
        href="/onboarding"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-card border border-textSecondary/30 hover:border-accent text-main font-extrabold px-7 py-3.5 rounded-2xl text-base shadow-sm hover:scale-105 transition-all"
      >
        <span>🚀 Start Learning Roadmap</span>
      </a>
    </div>

    {/* Secondary Contact Link */}
    <div class="pt-4 text-xs font-mono text-textSecondary font-medium">
      Think this is a broken link? <a href="/contact" class="text-accent underline font-bold">Report it to our support team 💬</a>
    </div>

  </div>
</Layout>
